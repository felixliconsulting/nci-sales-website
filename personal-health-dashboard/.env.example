# Copy to apps/web/.env.local and Vercel project settings.
# Never commit real secrets.

# Public (browser-safe)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
MOTIVATION_INGEST_TOKEN=generate-a-long-random-string
SYNC_BOT_TOKEN=generate-another-long-random-string
DASHBOARD_USER_ID=uuid-of-felix-supabase-auth-user

# Oura OAuth (server-only)
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=http://localhost:3000/api/oura/callback

# Optional encryption key for stored OAuth tokens (32+ chars)
TOKEN_ENCRYPTION_KEY=generate-a-long-random-string-32chars

# Default interpretation timezone
APP_TIMEZONE=America/Vancouver
